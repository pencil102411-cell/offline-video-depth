{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "离线深度视频",
  "version": "0.3.0",
  "identifier": "com.local.offline-video-depth",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../release/engine-dist/depth-video/": "engine-v2/",
      "../release/offline-video-depth/cli/ffmpeg.exe": "engine-v2/ffmpeg.exe",
      "../hf_cache/models--depth-anything--Depth-Anything-V2-Small-hf/snapshots/5426e4f0f36572d16453bbda7a8389317b1bef99/": "engine-v2/model/",
      "../LICENSE": "licenses/LICENSE.txt",
      "../NOTICE": "licenses/NOTICE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {"type": "offlineInstaller"},
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "zlib",
        "languages": ["SimpChinese"],
        "startMenuFolder": "离线深度视频"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "离线深度视频",
        "width": 1120,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  }
}
